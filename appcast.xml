<?xml version="1.0" standalone="yes"?>
<!--
  Sparkle appcast for Swivel.

  Each <item> describes one release that auto-update-eligible builds
  (Swivel ≥ 1.1.0) can fetch + install. Add a new <item> AT THE TOP
  of the <channel> when cutting a release. The signing tool prints
  the `enclosure` line ready to paste:

      sign_update build/Swivel-X.Y.Z.zip

  See docs/ARCHITECTURE.md → "Release process" for the end-to-end
  flow. Anatomy of an enclosure:

    url            — public download URL (we use the GitHub Releases asset)
    length         — byte length of the zip (the `length` field shasum -a 256 outputs)
    type           — "application/octet-stream" for any zip
    sparkle:edSignature  — base64 EdDSA signature, generated by `sign_update`
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
    <channel>
        <title>Swivel Updates</title>
        <link>https://github.com/jspanji/Swivel</link>
        <description>Auto-update feed for Swivel — switch between Claude Desktop accounts in two seconds.</description>
        <language>en</language>

        <!-- v1.0.0 was shipped before Sparkle existed in the app. It has
             no <item> here intentionally: users on 1.0.0 have no
             updater wired up and would never read this feed anyway.
             They'll need to manually download 1.1.0 the first time.
             From 1.1.0 onward, auto-update kicks in. -->

    </channel>
</rss>
